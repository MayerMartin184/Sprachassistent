# --- Claude (Pflicht) ---
ANTHROPIC_API_KEY=sk-ant-...
ASSISTANT_MODEL=claude-opus-5
# low | medium | high | xhigh | max  (medium = gute Balance aus Tempo und Qualität für Sprachdialog)
ASSISTANT_EFFORT=medium

# --- Azure Speech (Spracherkennung + Sprachausgabe). Ohne diese Werte läuft die App im Textmodus. ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=germanywestcentral
# Erkennung parallel in diesen Sprachen (das sicherste Ergebnis gewinnt)
SPEECH_LANGUAGES=de-DE,ro-RO
# Stimme aus der Palette (siehe Einstellungsdialog): seraphina, florian, katja, conrad, monster, roboter, kind ...
TTS_PRESET=seraphina
# Optional: explizite Azure-Stimme, überstimmt die Palette
TTS_VOICE=

# --- Mikrofon: leer = Windows-Standard; sonst Nummer oder Namensteil aus der Liste, die Jarvis beim Start zeigt ---
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=

# --- Wake-Word (lokal, ohne Cloud). Name wird auch in der Anrede verwendet. ---
WAKE_WORD_ENABLED=true
WAKE_WORD_MODEL=hey_jarvis
# 0.3 = empfindlicher (mehr Fehlauslösungen), 0.7 = strenger
WAKE_WORD_THRESHOLD=0.5
# Pause in Millisekunden, nach der ein gesprochener Auftrag abgeschickt wird
SPEECH_END_SILENCE_MS=1500
# Sprach-Aktivitätserkennung: 0.3 = empfindlicher, 0.7 = strenger
VAD_THRESHOLD=0.5
# Nach einer Antwort so viele Sekunden ohne Wake-Word weiter zuhören
ATTENTION_SECONDS=20
ASSISTANT_NAME=Jarvis

# --- Design (Hex-Farben; Standard ist das Mayer-E-Concept-Design; LOGO_PATH = PNG-Datei) ---
BRAND_BG=#0c171b
BRAND_PANEL=#122126
BRAND_GRID=#16262c
BRAND_LINE=#2f5a63
BRAND_PRIMARY=#a7e3ea
BRAND_ACCENT=#5fb3bf
BRAND_TEXT=#f2f7f8
BRAND_MUTED=#8fa4ab
BRAND_FONT=Segoe UI
BRAND_MONO=Consolas
BRAND_TITLE=Mayer E-Concept · Assistant
LOGO_PATH=

# --- Webcam (braucht: pip install -e ".[webcam]") ---
WEBCAM_ENABLED=true
WEBCAM_INDEX=0
# Präsenz: Kamera beobachtet lokal (Gesichter zählen), Jarvis kommentiert Ankunft und wiederholte Störungen
PRESENCE_ENABLED=true
PRESENCE_COOLDOWN_MIN=10
PRESENCE_ABSENCE_MIN=10
# So viele Minuten vor einem Termin meldet sich Jarvis von selbst
CALENDAR_LEAD_MINUTES=10

# --- Microsoft 365 (To Do, E-Mail, Kalender, Teams-Transkripte). Ohne MS_CLIENT_ID deaktiviert. ---
MS_CLIENT_ID=
MS_TENANT_ID=common

# --- Dateiablage: Wurzelordner, außerhalb dessen der Assistent nichts anfasst ---
DOCUMENTS_ROOT=~/Documents
TIMEZONE=Europe/Berlin
